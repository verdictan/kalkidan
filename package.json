{
  "name": "kalkidan",
  "version": "0.1.0",
  "private": true,
  "description": "A project, repository, and session manager for Codex and Claude Code",
  "author": "Kalkidan",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build:electron": "esbuild electron/main.ts electron/preload.ts electron/remote-agent.ts --bundle --platform=node --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "test": "tsx --test tests/*.test.ts",
    "dist:mac": "npm run build && electron-builder --mac",
    "preview": "vite --host 127.0.0.1",
    "test:ui": "playwright test",
    "test:desktop": "npm run build && node tests/desktop.smoke.mjs"
  },
  "build": {
    "appId": "dev.kalkidan.desktop",
    "productName": "Kalkidan",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
