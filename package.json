{
  "name": "kalkidan",
  "version": "0.1.0",
  "private": true,
  "description": "A project, repository, and session manager for Codex and Claude Code",
  "author": "Kalkidan",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build:electron": "esbuild electron/main.ts electron/preload.ts electron/remote-agent.ts --bundle --platform=node --external:electron --external:node-pty --outdir=dist-electron --out-extension:.js=.cjs",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "test": "tsx --test tests/*.test.ts",
    "dist:mac": "npm run build && electron-builder --mac",
    "preview": "vite --host 127.0.0.1",
    "test:ui": "playwright test",
    "test:desktop": "npm run build && node tests/desktop.smoke.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/check-boundaries.mjs",
    "test:ci:ui": "playwright test tests/onboarding.spec.ts tests/folder-picker.spec.ts tests/github-cli-settings.spec.ts tests/project-docs.spec.ts tests/repository-refresh.spec.ts --workers=2 --reporter=line",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win -c.npmRebuild=false",
    "package:release": "node scripts/package-release.mjs",
    "prepare": "node .husky/install.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:backend:coverage": "c8 node scripts/test-backend-determinism.mjs",
    "test:backend:coverage:strict": "c8 --100 --per-file node scripts/test-backend-determinism.mjs",
    "test:backend:deterministic": "node scripts/test-backend-determinism.mjs",
    "test:backend:repeat": "node scripts/test-backend-determinism.mjs --repeat"
  },
  "build": {
    "appId": "dev.kalkidan.desktop",
    "productName": "Kalkidan",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/icon.icns"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "public/brand/icon-512.png",
      "maintainer": "Verdictan <support@verdictan.com>"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tar": "7.5.22",
    "tw-animate-css": "^1.4.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "c8": "12.0.0",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "storybook": "^10.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "@electron/get@3": {
      "global-agent": "^4.1.3"
    }
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "npm@12.2.0",
  "homepage": "https://github.com/verdictan/kalkidan"
}
