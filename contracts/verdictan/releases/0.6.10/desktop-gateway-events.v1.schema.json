{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop gateway evidence poll response v1",
  "type": "object",
  "required": ["schema_version", "generation_id", "runtime_id", "session_id", "cursor", "gap", "reconciliation_required", "events", "has_more", "retention_seconds"],
  "properties": {
    "schema_version": { "const": 1 },
    "generation_id": { "type": "string" },
    "runtime_id": { "type": "string" },
    "session_id": { "type": "string" },
    "cursor": { "type": "string", "maxLength": 256 },
    "gap": { "type": "boolean" },
    "reconciliation_required": { "type": "boolean" },
    "has_more": { "type": "boolean" },
    "retention_seconds": { "const": 900 },
    "events": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["schema_version", "generation_id", "sequence", "event", "correlation_id", "request_id", "session_id", "data"],
        "properties": {
          "schema_version": { "const": 1 },
          "generation_id": { "type": "string" },
          "sequence": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "event": { "enum": ["policy.decision", "request.attempt_authorized", "request.attempt_started", "request.attempt_transport", "usage.updated", "usage.settled", "usage.released", "audit.queued", "audit.delivery"] },
          "correlation_id": { "type": "string" },
          "request_id": { "type": "string" },
          "session_id": { "type": "string" },
          "data": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
