{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host-authoritative update operation snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "operation_id",
    "installation_id",
    "host_id",
    "component",
    "target_release_id",
    "previous_release_id",
    "expected_sha256",
    "generation",
    "sequence",
    "phase",
    "started_at",
    "updated_at",
    "bytes_completed",
    "bytes_total",
    "confirmed_active_release_id",
    "retryable",
    "error_code"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "host_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "component": {
      "const": "verdictan-cli"
    },
    "target_release_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_release_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "requested",
        "downloading",
        "verifying",
        "staged",
        "waiting-for-idle",
        "activating",
        "validating",
        "completed",
        "canceled",
        "failed",
        "interrupted",
        "unknown-outcome",
        "rolling-back",
        "rolled-back",
        "rollback-failed"
      ]
    },
    "started_at": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0
    },
    "bytes_completed": {
      "type": "integer",
      "minimum": 0
    },
    "bytes_total": {
      "type": "integer",
      "minimum": 0
    },
    "confirmed_active_release_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^release\\.[a-z_]{1,64}$"
    }
  },
  "additionalProperties": true
}
