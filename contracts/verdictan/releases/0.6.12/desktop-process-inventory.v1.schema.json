{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Captured running CLI identity",
  "type": "object",
  "required": [
    "schema_version",
    "component",
    "cli_version",
    "source_revision",
    "executable_sha256",
    "packaged",
    "protocol_min",
    "protocol_max"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "component": {
      "const": "verdictan-cli"
    },
    "cli_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "executable_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "packaged": {
      "type": "boolean"
    },
    "protocol_min": {
      "type": "integer",
      "minimum": 1
    },
    "protocol_max": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
