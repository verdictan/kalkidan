{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SECRET inherited descriptor 3 credential frame; not an stdout event",
  "type": "object",
  "required": [
    "schema_version",
    "correlation_id",
    "runtime_id",
    "runtime_registration_id",
    "session_id",
    "gateway_id",
    "agent_id",
    "api_url",
    "expires_at",
    "runtime_credential",
    "inference_credential",
    "generation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "runtime_id": {
      "type": "string"
    },
    "runtime_registration_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "gateway_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "api_url": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "runtime_credential": {
      "type": "string",
      "minLength": 1,
      "$comment": "SECRET. Protected inherited pipe only; never ordinary stdout or logs."
    },
    "inference_credential": {
      "type": "string",
      "minLength": 1,
      "$comment": "SECRET. Protected inherited pipe only; never ordinary stdout or logs."
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "provider_access_mode": {
      "enum": [
        "byok",
        "codex_subscription",
        "claude_subscription"
      ]
    }
  },
  "additionalProperties": false
}
