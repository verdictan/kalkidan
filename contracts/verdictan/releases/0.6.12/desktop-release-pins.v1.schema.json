{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verdictan.com/contracts/desktop-release-pins.v1.schema.json",
  "title": "Independently reviewed desktop release pins; never populated from downloaded metadata",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "manifest_sha256",
    "artifact_url",
    "artifact_sha256",
    "revoked_versions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "revoked_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
      }
    }
  }
}
