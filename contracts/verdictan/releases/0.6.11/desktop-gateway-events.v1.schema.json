{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop gateway evidence poll response v1",
  "type": "object",
  "required": ["schema_version", "generation_id", "runtime_id", "session_id", "cursor", "gap", "reconciliation_required", "events", "has_more", "retention_seconds"],
  "properties": {
    "schema_version": { "const": 1 },
    "generation_id": { "type": "string" },
    "runtime_id": { "type": "string" },
    "session_id": { "type": "string" },
    "cursor": { "type": "string", "maxLength": 256 },
    "gap": { "type": "boolean" },
    "reconciliation_required": { "type": "boolean" },
    "has_more": { "type": "boolean" },
    "retention_seconds": { "const": 900 },
    "event_buffer": {
      "description": "The durable event buffer of the gateway. Null when the gateway has none. With the drop_oldest_non_usage policy, dropped_events and expired_events count the policy decision and trail events that the gateway removed without delivery. Usage records stay until delivery.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["policy", "limit_bytes", "used_bytes", "dropped_events", "expired_events", "last_dropped_at"],
          "properties": {
            "policy": { "enum": ["refuse", "drop_oldest_non_usage"] },
            "limit_bytes": { "type": "integer", "minimum": 1 },
            "used_bytes": { "type": "integer", "minimum": 0 },
            "dropped_events": { "type": "integer", "minimum": 0 },
            "expired_events": { "type": "integer", "minimum": 0 },
            "last_dropped_at": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      ]
    },
    "events": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["schema_version", "generation_id", "sequence", "event", "correlation_id", "request_id", "session_id", "data"],
        "properties": {
          "schema_version": { "const": 1 },
          "generation_id": { "type": "string" },
          "sequence": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "event": { "enum": ["policy.decision", "request.attempt_authorized", "request.attempt_started", "request.attempt_transport", "usage.updated", "usage.settled", "usage.released", "audit.queued", "audit.delivery"] },
          "correlation_id": { "type": "string" },
          "request_id": { "type": "string" },
          "session_id": { "type": "string" },
          "data": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
