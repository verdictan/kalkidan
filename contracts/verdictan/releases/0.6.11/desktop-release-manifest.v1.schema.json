{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verdictan.com/contracts/desktop-release-manifest.v1.schema.json",
  "title": "Desktop release manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "sequence",
    "issued_at",
    "expires_at",
    "minimum_desktop_version",
    "protocol",
    "revoked_versions",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "minimum_desktop_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "protocol": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "signing": {
      "type": "object",
      "required": [
        "format",
        "key_id"
      ],
      "properties": {
        "format": {
          "const": "sigstore-bundle"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revoked_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target",
          "os",
          "arch",
          "url",
          "sha256",
          "size",
          "node_included",
          "required_runtime_dependencies",
          "minimum_os_version"
        ],
        "properties": {
          "target": {
            "enum": [
              "x86_64-unknown-linux-gnu",
              "aarch64-unknown-linux-gnu",
              "x86_64-apple-darwin",
              "aarch64-apple-darwin",
              "x86_64-pc-windows-msvc"
            ]
          },
          "os": {
            "enum": [
              "linux",
              "darwin",
              "win32"
            ]
          },
          "arch": {
            "enum": [
              "x64",
              "arm64"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "signature_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "node_included": {
            "const": true
          },
          "required_runtime_dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "minimum_os_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "executable_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "redistribution_notice": {
            "const": "KALKIDAN_REDISTRIBUTION.md"
          }
        }
      }
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
