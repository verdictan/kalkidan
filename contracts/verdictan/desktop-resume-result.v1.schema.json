{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "compatible",
        "incompatible",
        "invalid"
      ]
    },
    "code": {
      "enum": [
        null,
        "desktop.resume_binding_invalid",
        "desktop.resume_incompatible"
      ]
    },
    "mismatched_fields": {
      "type": "array",
      "items": {
        "enum": [
          "organization_id",
          "user_id",
          "region_id",
          "provider_connection_id",
          "installation_id",
          "host_id",
          "conversation_id",
          "provider",
          "model",
          "agent_kind",
          "agent_version",
          "context_format_version"
        ]
      }
    },
    "recovery_action": {
      "enum": [
        "check_gateway_and_current_policy",
        "explicit_reauthorization_and_context_transfer"
      ]
    },
    "dispatch_allowed": {
      "const": false
    },
    "requires_gateway_readiness": {
      "const": true
    },
    "requires_current_policy_evaluation": {
      "const": true
    },
    "transfer_authorized": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "status",
    "code",
    "mismatched_fields",
    "recovery_action",
    "dispatch_allowed",
    "requires_gateway_readiness",
    "requires_current_policy_evaluation",
    "transfer_authorized"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "desktop-resume-result.v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "compatible"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "const": null
          },
          "recovery_action": {
            "const": "check_gateway_and_current_policy"
          },
          "mismatched_fields": {
            "minItems": 0,
            "maxItems": 0,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "const": "desktop.resume_binding_invalid"
          },
          "recovery_action": {
            "const": "explicit_reauthorization_and_context_transfer"
          },
          "mismatched_fields": {
            "minItems": 0,
            "maxItems": 0,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "incompatible"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "const": "desktop.resume_incompatible"
          },
          "recovery_action": {
            "const": "explicit_reauthorization_and_context_transfer"
          },
          "mismatched_fields": {
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true
          }
        }
      }
    }
  ]
}
