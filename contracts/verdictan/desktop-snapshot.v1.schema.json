{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoritative desktop runtime snapshot protocol 1",
  "type": "object",
  "required": ["schema_version", "runtime_id", "session_id", "authority", "consistency", "observed_at", "requests", "has_more", "next_cursor", "absence_means", "replay_executes_requests"],
  "properties": {
    "schema_version": {"const": 1},
    "runtime_id": {"type": "string"},
    "session_id": {"type": "string"},
    "authority": {"const": "verdictan-control-plane"},
    "consistency": {"const": "repeatable-read-page"},
    "observed_at": {"type": "string"},
    "has_more": {"type": "boolean"},
    "next_cursor": {"type": ["string", "null"], "maxLength": 1024},
    "absence_means": {"const": "unknown_or_not_ingested"},
    "replay_executes_requests": {"const": false},
    "requests": {"type": "array", "maxItems": 100, "items": {
      "type": "object", "required": ["request_id", "policy", "usage", "review", "review_authority"],
      "properties": {
        "request_id": {"type": "string"},
        "review": {"type": "null"},
        "review_authority": {"const": "account_broker"},
        "policy": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["event_id", "audit_state"], "properties": {"event_id": {"type": ["string", "null"]}, "audit_state": {"const": "ingested"}}}]},
        "usage": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["authorization_id", "attempt_id", "state", "dispatch_state", "actual_cost", "estimated_cost", "input_tokens", "output_tokens", "total_tokens", "currency", "provider_charge"], "properties": {
          "actual_cost": {"$ref": "#/$defs/measurement"}, "estimated_cost": {"$ref": "#/$defs/measurement"},
          "input_tokens": {"$ref": "#/$defs/measurement"}, "output_tokens": {"$ref": "#/$defs/measurement"}, "total_tokens": {"$ref": "#/$defs/measurement"},
          "currency": {"type": ["string", "null"]}, "provider_charge": {"const": "not_reported"}
        }}]}
      }
    }}
  },
  "$defs": {"measurement": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}}
}
