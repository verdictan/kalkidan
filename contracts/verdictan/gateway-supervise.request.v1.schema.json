{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implemented gateway supervise control request",
  "type": "object",
  "required": [
    "schema_version",
    "correlation_id",
    "generation_id",
    "operation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "generation_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation": {
      "enum": [
        "gateway.status",
        "gateway.shutdown"
      ]
    }
  },
  "additionalProperties": true
}
